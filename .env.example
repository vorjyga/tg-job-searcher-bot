# Required for stage 1. The asyncpg driver is required.
DATABASE_URL=postgresql+asyncpg://tg_jobs:change-me@127.0.0.1:5432/tg_jobs
# Docker Compose only: name of the existing Docker network shared with PostgreSQL.
# TG_JOBS_DOCKER_NETWORK=existing_postgres_network

# Optional settings used in stage 1.
LOG_LEVEL=INFO
DATABASE_CONNECT_TIMEOUT_SECONDS=10
APP_LOCK_KEY=742109436318294807

# OWNER_TELEGRAM_ID receives new-user notifications and daily analytics reports.
BOT_TOKEN=
OWNER_TELEGRAM_ID=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Absolute path to a file containing Telethon StringSession (created by `tg-jobs-searcher auth`).
TELEGRAM_SESSION_PATH=/var/lib/tg-jobs-searcher/telethon.session
