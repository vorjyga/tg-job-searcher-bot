[Unit]
Description=Telegram jobs searcher
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=tg-jobs-searcher
Group=tg-jobs-searcher
WorkingDirectory=/opt/tg-jobs-searcher
EnvironmentFile=/etc/tg-jobs-searcher/tg-jobs-searcher.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=/opt/tg-jobs-searcher/.venv/bin/alembic upgrade head
ExecStart=/opt/tg-jobs-searcher/.venv/bin/tg-jobs-searcher
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/tg-jobs-searcher

[Install]
WantedBy=multi-user.target
